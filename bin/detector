#!/usr/bin/env php
<?php

declare(strict_types=1);

$mainDir = __DIR__ . '/../';

require_once $mainDir . 'vendor/autoload.php';

use BlueDuplicateDetector\Command\DuplicatedFilesCommand;
use BlueDuplicateDetector\Hasher\RedisTransport;
use Symfony\Component\Console\Application;
use Symfony\Component\Console\Output\ConsoleOutput;

$composer = json_decode(file_get_contents($mainDir . 'composer.json'));

try {
    // --redis connection as JSON, same variable the lib passes to workers; missing = 127.0.0.1:6379
    $redis = json_decode(getenv(RedisTransport::ENV) ?: '[]', true)
        ?? throw new InvalidArgumentException(RedisTransport::ENV . ' is not valid JSON.');
    $command = new DuplicatedFilesCommand('duplicate', ['/duplicates'], '/out', $redis);
    $application = new Application($composer->description, $composer->version);

    $application->addCommand($command);
    $application->setDefaultCommand($command->getName(), true);

    exit($application->run());
} catch (Throwable $exception) {
    (new ConsoleOutput())->writeln('<error>' . $exception->getMessage() . '</error>');
    exit(1);
}
